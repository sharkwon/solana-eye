{
  "rpc": {
    "url": "https://api.mainnet-beta.solana.com",
    "timeout": 20,
    "max_retries": 2
  },
  "collect": {
    "performance_samples": 10,
    "fee_sample_blocks": 10,
    "top_validators": 20,
    "history_keep_days": 90
  },
  "anomaly": {
    "tps_drop_pct": 30.0,
    "slot_time_sec_max": 0.6,
    "delinquent_stake_pct_max": 5.0,
    "tvl_drop_pct": 5.0,
    "price_drop_pct": 5.0,
    "dau_drop_pct": 15.0,
    "tokenized_equities_volume_change_pct": 20.0,
    "nakamoto_min": 5,
    "zscore_threshold": 3.0,
    "min_history": 8,
    "correlations": [
      {
        "name": "coordinated_drawdown",
        "severity": "warning",
        "direction": "below",
        "default_threshold": -3.0,
        "min_count": 2,
        "message": "Coordinated drawdown: price, TVL and/or DEX volume falling together",
        "metrics": [
          {"path": ["economics", "sol_price_24h_change_pct"], "label": "SOL price"},
          {"path": ["economics", "tvl_24h_change_pct"], "label": "TVL"},
          {"path": ["economics", "dex_volume_24h_change_pct"], "label": "DEX volume"}
        ]
      },
      {
        "name": "network_stress",
        "severity": "warning",
        "direction": "above",
        "default_threshold": 0.5,
        "min_count": 2,
        "message": "Network stress: slow slots and high delinquency together",
        "metrics": [
          {"path": ["slot_time_sec", "avg"], "label": "slot time"},
          {"path": ["validators", "delinquent_stake_pct"], "label": "delinquent stake"}
        ]
      }
    ]
  },
  "healthscore": {
    "weights": {
      "tps": 3,
      "slot_time": 2,
      "validators": 2,
      "tvl_trend": 1,
      "price_trend": 1,
      "network_status": 2
    },
    "targets": {
      "tps_target": 1500.0,
      "slot_time_ideal": 0.4,
      "slot_time_bad": 0.8,
      "delinquent_max": 5.0
    }
  },
  "comparison": {
    "chains": ["Solana", "Ethereum", "Base", "Tron", "Arbitrum"]
  },
  "baselines": {
    "series": [
      {"key": "tps_avg", "path": ["tps", "avg"], "label": "Avg TPS", "higher_is_better": true},
      {"key": "slot_time_sec", "path": ["slot_time_sec", "avg"], "label": "Slot time (s)", "higher_is_better": false},
      {"key": "tvl_usd", "path": ["economics", "tvl_usd"], "label": "TVL (USD)", "higher_is_better": true},
      {"key": "sol_price_usd", "path": ["economics", "sol_price_usd"], "label": "SOL price (USD)", "higher_is_better": true},
      {"key": "dex_volume_24h_usd", "path": ["economics", "dex_volume_24h_usd"], "label": "DEX volume 24h (USD)", "higher_is_better": true}
    ]
  },
  "render": {
    "currency": "USD",
    "timezone": "UTC",
    "refresh_interval_min": 60,
    "title": "Solana Eye — Solana Ecosystem Report"
  },
  "sources": {
    "defillama": true,
    "coingecko": true,
    "github_simd": true,
    "statuspage": true,
    "dune": {
      "enabled": true,
      "api_key_env": "DUNE_API_KEY",
      "queries": {
        "dau": 5941260,
        "tokenized": 0
      }
    },
    "twitter": true,
    "twitter_accounts": [
      "solana",
      "SolanaFndn",
      "SolanaFloor",
      "solana_daily",
      "SolanaEvents"
    ]
  }
}
